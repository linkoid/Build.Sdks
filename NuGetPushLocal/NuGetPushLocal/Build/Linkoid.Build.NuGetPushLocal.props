<Project>

  <PropertyGroup>
    <NuGetPushLocalFeed Condition="'$(NuGetPushLocalFeed)' == ''">$(NuGetPackageRoot)</NuGetPushLocalFeed>
    <NuGetPushLocalOnPack Condition="'$(NuGetPushLocalOnPack)' == ''">true</NuGetPushLocalOnPack>
    <NuGetDeleteLocalOnClean Condition="'$(NuGetDeleteLocalOnClean)' == ''"></NuGetDeleteLocalOnClean>
  </PropertyGroup>
  
</Project>